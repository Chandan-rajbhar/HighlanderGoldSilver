# Highlander Gold & Silver — Admin Dashboard Environment Configuration
# Copy this file to .env and provide your project keys when ready to connect Supabase

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Client Key (Public anon key - safe for frontend)
VITE_SUPABASE_ANON_KEY=

# Note: Never place service_role secret keys in frontend environment files.

